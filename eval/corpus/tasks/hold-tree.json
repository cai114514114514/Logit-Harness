{
  "id": "hold-tree",
  "language": "typescript",
  "kind": "new",
  "split": "holdout",
  "title": "Tree flattening",
  "trigger": "first_write",
  "requirements": [
    "data 是 {name,children?} 树。按前序遍历输出每个节点的路径字符串数组，名称用 / 连接。",
    "初始输出全部节点，名称不含 /，缺少 children 视为空数组。"
  ],
  "correction": "改为只输出叶节点路径；路径仍包含所有祖先名称。 调用者已更新 verify.py；不要修改该文件，保留其余要求和 NOTES.txt。",
  "notes": "Caller notes for hold-tree: preserve this file byte for byte.\n",
  "checks": [
    {
      "id": "leaf",
      "group": "core",
      "input": {
        "op": "solve",
        "data": {
          "name": "x"
        }
      },
      "expected": [
        "x"
      ],
      "public": true
    },
    {
      "id": "empty-child",
      "group": "core",
      "input": {
        "op": "solve",
        "data": {
          "name": "x",
          "children": []
        }
      },
      "expected": [
        "x"
      ],
      "public": false
    },
    {
      "id": "branch",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": {
          "name": "a",
          "children": [
            {
              "name": "b"
            },
            {
              "name": "c"
            }
          ]
        }
      },
      "expected": [
        "a/b",
        "a/c"
      ],
      "public": true,
      "before": [
        "a",
        "a/b",
        "a/c"
      ]
    },
    {
      "id": "deep",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": {
          "name": "a",
          "children": [
            {
              "name": "b",
              "children": [
                {
                  "name": "c"
                }
              ]
            }
          ]
        }
      },
      "expected": [
        "a/b/c"
      ],
      "public": false,
      "before": [
        "a",
        "a/b",
        "a/b/c"
      ]
    },
    {
      "id": "unicode",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": {
          "name": "中"
        }
      },
      "expected": [
        "中"
      ],
      "public": false
    },
    {
      "id": "empty-name",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": {
          "name": ""
        }
      },
      "expected": [
        ""
      ],
      "public": false
    }
  ]
}
