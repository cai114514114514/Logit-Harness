{
  "id": "hold-versions",
  "language": "rust",
  "kind": "existing",
  "split": "holdout",
  "title": "Numeric version comparison",
  "trigger": "active_check",
  "requirements": [
    "data 是两个点分非负整数版本字符串数组。比较数字段，返回 -1、0 或 1；初始相同前缀时较短版本更小。",
    "修复按字符串比较数字段的问题，不包含 prerelease 或 metadata。"
  ],
  "correction": "末尾缺省段视为 0，因此 1、1.0、1.0.0 等价。 调用者已更新 verify.py；不要修改该文件，保留其余要求和 NOTES.txt。",
  "notes": "Caller notes for hold-versions: preserve this file byte for byte.\n",
  "checks": [
    {
      "id": "numeric",
      "group": "core",
      "input": {
        "op": "solve",
        "data": [
          "1.10",
          "1.2"
        ]
      },
      "expected": 1,
      "public": true
    },
    {
      "id": "different",
      "group": "core",
      "input": {
        "op": "solve",
        "data": [
          "2",
          "3"
        ]
      },
      "expected": -1,
      "public": false
    },
    {
      "id": "zero-tail",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": [
          "1",
          "1.0"
        ]
      },
      "expected": 0,
      "public": true,
      "before": -1
    },
    {
      "id": "long-zero",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": [
          "2.0.0",
          "2"
        ]
      },
      "expected": 0,
      "public": false,
      "before": 1
    },
    {
      "id": "equal",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": [
          "0",
          "0"
        ]
      },
      "expected": 0,
      "public": false
    },
    {
      "id": "nonzero-tail",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": [
          "1",
          "1.0.1"
        ]
      },
      "expected": -1,
      "public": false
    }
  ]
}
