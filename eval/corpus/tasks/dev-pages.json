{
  "id": "dev-pages",
  "language": "typescript",
  "kind": "existing",
  "split": "development",
  "title": "Cursor pagination",
  "trigger": "active_check",
  "requirements": [
    "data 含升序唯一整数 items、整数 cursor 和非负整数 limit。初始选 items 中 >= cursor 的前 limit 项。",
    "修复 limit=0 时返回全部数据的问题。"
  ],
  "correction": "cursor 改为排他边界，仅选择 > cursor 的项目。 调用者已更新 verify.py；不要修改该文件，保留其余要求和 NOTES.txt。",
  "notes": "Caller notes for dev-pages: preserve this file byte for byte.\n",
  "checks": [
    {
      "id": "between",
      "group": "core",
      "input": {
        "op": "solve",
        "data": {
          "items": [
            1,
            3,
            5
          ],
          "cursor": 2,
          "limit": 2
        }
      },
      "expected": [
        3,
        5
      ],
      "public": true
    },
    {
      "id": "zero",
      "group": "core",
      "input": {
        "op": "solve",
        "data": {
          "items": [
            1,
            2
          ],
          "cursor": 0,
          "limit": 0
        }
      },
      "expected": [],
      "public": false
    },
    {
      "id": "boundary",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": {
          "items": [
            1,
            2,
            3
          ],
          "cursor": 2,
          "limit": 2
        }
      },
      "expected": [
        3
      ],
      "public": true,
      "before": [
        2,
        3
      ]
    },
    {
      "id": "last",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": {
          "items": [
            1,
            2
          ],
          "cursor": 2,
          "limit": 4
        }
      },
      "expected": [],
      "public": false,
      "before": [
        2
      ]
    },
    {
      "id": "empty",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": {
          "items": [],
          "cursor": 0,
          "limit": 1
        }
      },
      "expected": [],
      "public": false
    },
    {
      "id": "negative",
      "group": "edge",
      "input": {
        "op": "solve",
        "data": {
          "items": [
            -4,
            -2,
            0
          ],
          "cursor": -3,
          "limit": 9
        }
      },
      "expected": [
        -2,
        0
      ],
      "public": false
    }
  ]
}
