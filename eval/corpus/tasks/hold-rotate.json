{
  "id": "hold-rotate",
  "language": "rust",
  "kind": "new",
  "split": "holdout",
  "title": "Rectangular matrix rotation",
  "trigger": "active_check",
  "requirements": [
    "data 是矩形二维整数数组。初始顺时针旋转 90 度并返回新矩阵。",
    "空矩阵返回空数组，非空矩阵每行至少一项。"
  ],
  "correction": "方向改为逆时针旋转 90 度；仍支持非正方形矩阵。 调用者已更新 verify.py；不要修改该文件，保留其余要求和 NOTES.txt。",
  "notes": "Caller notes for hold-rotate: preserve this file byte for byte.\n",
  "checks": [
    {
      "id": "single",
      "group": "core",
      "input": {
        "op": "solve",
        "data": [
          [
            7
          ]
        ]
      },
      "expected": [
        [
          7
        ]
      ],
      "public": true
    },
    {
      "id": "equal",
      "group": "core",
      "input": {
        "op": "solve",
        "data": [
          [
            1,
            1
          ],
          [
            1,
            1
          ]
        ]
      },
      "expected": [
        [
          1,
          1
        ],
        [
          1,
          1
        ]
      ],
      "public": false
    },
    {
      "id": "square",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      },
      "expected": [
        [
          2,
          4
        ],
        [
          1,
          3
        ]
      ],
      "public": true,
      "before": [
        [
          3,
          1
        ],
        [
          4,
          2
        ]
      ]
    },
    {
      "id": "rectangle",
      "group": "correction",
      "input": {
        "op": "solve",
        "data": [
          [
            1,
